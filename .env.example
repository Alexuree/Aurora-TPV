# =====================================================================
# Aurora TPV - Variables de entorno (PLANTILLA)
# =====================================================================
# Copia este archivo como ".env" y rellena los valores.
#
# MODO DE PERSISTENCIA
# - Si NO defines las variables de Supabase, la app arranca en MODO LOCAL
#   (datos en el navegador, localStorage).
# - Si defines VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY, la app usa
#   Supabase (PostgreSQL en la nube, varios terminales).
# ---------------------------------------------------------------------

# URL del proyecto Supabase (ej: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave pública "anon" del proyecto Supabase
VITE_SUPABASE_ANON_KEY=

# Forzar modo de datos: "local" | "supabase" | "auto" (por defecto: auto)
VITE_DATA_MODE=auto

# ---------------------------------------------------------------------
# CUENTA DE DISPOSITIVO (sin login, SOLO desarrollo/local)
# La app inicia sesión sola con esta cuenta al arrancar; no hay pantalla de
# acceso. Debe ser un usuario válido de Supabase Auth (con su perfil).
# En el despliegue web público deja estos campos VACÍOS: el shell Electron
# lee los secretos desde device.json en cada equipo.
# ---------------------------------------------------------------------
# Email y contraseña de la cuenta con la que opera este equipo
VITE_DEVICE_EMAIL=
VITE_DEVICE_PASSWORD=

# Operador mostrado por defecto (email/usuario). Si se deja vacío, usa la
# cuenta de dispositivo. El operador es el nombre que sale en el ticket.
VITE_DEFAULT_OPERATOR=
