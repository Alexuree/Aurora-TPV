# =====================================================================
# Aurora TPV - Variables de entorno (PLANTILLA)
# =====================================================================
# Copia este archivo como ".env" y rellena los valores.
#
# MODO DE PERSISTENCIA
# - Si NO defines las variables de Supabase, la app arranca en MODO LOCAL
#   (datos en el navegador, localStorage).
# - Si defines VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY, la app usa
#   Supabase (PostgreSQL en la nube, varios terminales).
# ---------------------------------------------------------------------

# URL del proyecto Supabase (ej: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave pública "anon" del proyecto Supabase
VITE_SUPABASE_ANON_KEY=

# Forzar modo de datos: "local" | "supabase" | "auto" (por defecto: auto)
VITE_DATA_MODE=auto
